---
// Bloch sphere explorer. Sliders set θ and φ; gate buttons rotate the state.
// Shows the state with alpha in purple and beta in teal, plus measurement probabilities.
interface Props { gates?: boolean; title?: string; start?: string; notice?: string }
const { gates = false, title = 'Try it: the Bloch sphere', start = '+', notice = 'Move θ to tip the arrow from the north pole (|0⟩) to the south pole (|1⟩). Move φ and notice that the 0/1 probabilities do not change at all: φ is the relative phase, which only shows up in other measurements (like +/−).' } = Astro.props;
---
<div class="lab bloch-lab" data-gates={gates ? '1' : ''} data-start={start}>
  <div class="eyebrow">{title}</div>
  <p class="notice">{notice}</p>
  <div class="lab-grid">
    <svg viewBox="-170 -170 340 340" role="img" aria-label="Bloch sphere showing the current state" style="background:var(--bg);border-radius:12px;border:1px solid var(--line)">
      <circle r="130" fill="none" stroke="var(--line)" stroke-width="1.5" />
      <path class="equator-back" fill="none" stroke="var(--line)" stroke-dasharray="4 4" />
      <path class="equator-front" fill="none" stroke="var(--muted)" />
      <path class="meridian" fill="none" stroke="var(--line)" stroke-dasharray="3 5" />
      <g class="axes" stroke="var(--muted)" stroke-width="1"></g>
      <g class="axis-labels" font-size="13"></g>
      <line class="shadow" stroke="var(--muted)" stroke-dasharray="3 3" />
      <line class="arrow" stroke="var(--accent)" stroke-width="4" stroke-linecap="round" />
      <circle class="tip" r="7" fill="var(--accent)" />
      <text class="readout svg-muted" x="-160" y="-152" font-size="12"></text>
    </svg>
    <div>
      <div class="state" style="font-size:1.25rem;margin:.2rem 0 .6rem" aria-live="polite"></div>
      <label class="small">θ (tilt from |0⟩): <span class="v-theta"></span>
        <input type="range" class="theta" min="0" max="180" step="1" />
      </label>
      <label class="small">φ (relative phase): <span class="v-phi"></span>
        <input type="range" class="phi" min="0" max="359" step="1" />
      </label>
      <div class="btn-row presets">
        <span class="small muted" style="align-self:center">Jump to:</span>
        {['0', '1', '+', '−', 'i', '−i'].map((p) => <button class="btn small secondary" type="button" data-preset={p}>|{p}⟩</button>)}
      </div>
      {gates && (
        <div class="btn-row gates">
          <span class="small muted" style="align-self:center">Apply a gate:</span>
          {['X', 'Y', 'Z', 'H', 'S', 'T'].map((g) => <button class="btn small" type="button" data-gate={g}>{g}</button>)}
        </div>
      )}
      <div class="gate-log small muted" aria-live="polite"></div>
      <div class="probs"></div>
    </div>
  </div>
</div>
<script>
  import { GATES, c, mul, add, abs2, expi, conj, type C } from '../lib/sim';
  import { bars, amp } from '../lib/ui';

  const R = 130;
  // simple oblique projection: x axis points out of the screen (down-left), y right, z up
  const P = (x: number, y: number, z: number): [number, number] => [R * (y * 0.95 - x * 0.38), -R * (z * 0.95 - x * 0.28)];

  document.querySelectorAll<HTMLElement>('.bloch-lab').forEach((root) => {
    const q = <T,>(s: string) => root.querySelector(s) as T;
    const thetaIn = q<HTMLInputElement>('.theta'), phiIn = q<HTMLInputElement>('.phi');
    let theta = Math.PI / 2, phi = 0;
    const presets: Record<string, [number, number]> = { '0': [0, 0], '1': [180, 0], '+': [90, 0], '−': [90, 180], 'i': [90, 90], '−i': [90, 270] };
    const [t0, p0] = presets[root.dataset.start ?? '+'] ?? [90, 0];
    theta = (t0 * Math.PI) / 180; phi = (p0 * Math.PI) / 180;

    // static geometry
    const path = (pts: [number, number][]) => 'M' + pts.map((p) => p.map((v) => v.toFixed(1)).join(' ')).join(' L');
    const eqFront: [number, number][] = [], eqBack: [number, number][] = [], mer: [number, number][] = [];
    for (let k = 0; k <= 32; k++) {
      const tf = -Math.PI / 2 + (k / 32) * Math.PI, tb = Math.PI / 2 + (k / 32) * Math.PI;
      eqFront.push(P(Math.cos(tf), Math.sin(tf), 0));
      eqBack.push(P(Math.cos(tb), Math.sin(tb), 0));
    }
    for (let k = 0; k <= 64; k++) { const t = (k / 64) * 2 * Math.PI; mer.push(P(Math.sin(t), 0, Math.cos(t))); }
    q<SVGPathElement>('.equator-front').setAttribute('d', path(eqFront));
    q<SVGPathElement>('.equator-back').setAttribute('d', path(eqBack));
    q<SVGPathElement>('.meridian').setAttribute('d', path(mer));
    const axes = q<SVGGElement>('.axes'), labels = q<SVGGElement>('.axis-labels');
    const ax: [number, number, number, string, string][] = [
      [0, 0, 1, '|0⟩', 'var(--alpha)'], [0, 0, -1, '|1⟩', 'var(--beta)'], [1, 0, 0, '|+⟩', 'var(--muted)'], [-1, 0, 0, '|−⟩', 'var(--muted)'], [0, 1, 0, '|i⟩', 'var(--muted)'], [0, -1, 0, '|−i⟩', 'var(--muted)'],
    ];
    for (const [x, y, z, l, col] of ax) {
      const [sx, sy] = P(x, y, z);
      axes.insertAdjacentHTML('beforeend', `<line x1="0" y1="0" x2="${sx}" y2="${sy}" stroke-dasharray="2 3"/>`);
      const [lx, ly] = P(x * 1.18, y * 1.18, z * 1.18);
      labels.insertAdjacentHTML('beforeend', `<text x="${lx - 12}" y="${ly + 5}" fill="${col}" font-family="var(--font)">${l}</text>`);
    }

    const stateOf = (): [C, C] => [c(Math.cos(theta / 2)), mul(expi(phi), c(Math.sin(theta / 2)))];
    function fromState(a: C, b: C) {
      // remove global phase so alpha is real and non-negative
      const ga = Math.atan2(a.im, a.re);
      const a2 = mul(a, expi(-ga)), b2 = mul(b, expi(-ga));
      theta = 2 * Math.atan2(Math.sqrt(abs2(b2)), a2.re);
      phi = Math.sqrt(abs2(b2)) < 1e-9 ? 0 : Math.atan2(b2.im, b2.re);
      if (phi < 0) phi += 2 * Math.PI;
    }
    function draw() {
      const [a, b] = stateOf();
      const x = Math.sin(theta) * Math.cos(phi), y = Math.sin(theta) * Math.sin(phi), z = Math.cos(theta);
      const [sx, sy] = P(x, y, z), [hx, hy] = P(x, y, 0);
      const set = (s: string, at: Record<string, number>) => { const el = q<SVGElement>(s); for (const k in at) el.setAttribute(k, at[k].toFixed(1)); };
      set('.arrow', { x1: 0, y1: 0, x2: sx, y2: sy }); set('.tip', { cx: sx, cy: sy });
      set('.shadow', { x1: sx, y1: sy, x2: hx, y2: hy });
      q<SVGTextElement>('.readout').textContent = `Bloch vector (x, y, z) = (${x.toFixed(2)}, ${y.toFixed(2)}, ${z.toFixed(2)})`;
      thetaIn.value = String(Math.round((theta * 180) / Math.PI));
      phiIn.value = String(Math.round((phi * 180) / Math.PI) % 360);
      q<HTMLElement>('.v-theta').textContent = `${thetaIn.value}°`;
      q<HTMLElement>('.v-phi').textContent = `${phiIn.value}°`;
      q<HTMLElement>('.state').innerHTML = `|ψ⟩ = <span class="amp-a">${amp(a)}</span>|0⟩ + <span class="amp-b">${amp(b)}</span>|1⟩`;
      const s2 = Math.SQRT1_2;
      const pPlus = abs2(add(a, b)) / 2, pI = abs2(add(a, mul(c(0, -1), b))) / 2;
      bars(q<HTMLElement>('.probs'), [
        { label: 'P(0) = |α|²', p: abs2(a), colour: 'var(--alpha)' },
        { label: 'P(1) = |β|²', p: abs2(b), colour: 'var(--beta)' },
        { label: 'P(+) = |α + β|²/2', p: pPlus, colour: 'var(--muted)' },
        { label: 'P(−) = |α − β|²/2', p: 1 - pPlus, colour: 'var(--muted)' },
        { label: 'P(i) = |α − iβ|²/2', p: pI, colour: 'var(--muted)' },
      ]);
      void s2; void conj;
    }
    thetaIn.addEventListener('input', () => { theta = (+thetaIn.value * Math.PI) / 180; draw(); });
    phiIn.addEventListener('input', () => { phi = (+phiIn.value * Math.PI) / 180; draw(); });
    root.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) => b.addEventListener('click', () => {
      const [t, p] = presets[b.dataset.preset!]; theta = (t * Math.PI) / 180; phi = (p * Math.PI) / 180; draw();
    }));
    const log = q<HTMLElement>('.gate-log');
    root.querySelectorAll<HTMLButtonElement>('[data-gate]').forEach((btn) => btn.addEventListener('click', () => {
      const g = GATES[btn.dataset.gate!];
      const [a, b] = stateOf();
      const na = add(mul(g[0], a), mul(g[1], b)), nb = add(mul(g[2], a), mul(g[3], b));
      fromState(na, nb);
      log.textContent = `Applied ${btn.dataset.gate}. (Global phase removed so α is real; it changes no probability.)`;
      draw();
    }));
    draw();
  });
</script>
