---
// Multiple-choice check. mode="predict": you commit to a guess before learning the idea;
// there is no penalty, and the explanation appears whatever you pick.
import { tex } from '../lib/tex';
interface Props { q: string; options: string[]; answer: number; explain: string; mode?: 'check' | 'predict'; tag?: string }
const { q, options, answer, explain, mode = 'check', tag } = Astro.props;
---
<div class="check" data-answer={answer} data-mode={mode} data-tag={tag}>
  <div class="eyebrow">{mode === 'predict' ? 'Guess first (before reading on)' : 'Quick check'}</div>
  <p set:html={tex(q)} />
  <div class="options" role="group">
    {options.map((o, i) => <button type="button" class="opt" data-i={i} set:html={`${String.fromCharCode(65 + i)}. ${tex(o)}`} />)}
  </div>
  <div class="feedback" aria-live="polite" hidden set:html={tex(explain)} />
</div>
<script>
  import { logError } from '../lib/store';
  document.querySelectorAll<HTMLElement>('.check').forEach((box) => {
    if (box.dataset.wired) return; box.dataset.wired = '1';
    const answer = Number(box.dataset.answer);
    const fb = box.querySelector<HTMLElement>('.feedback')!;
    box.querySelectorAll<HTMLButtonElement>('.opt').forEach((b) => b.addEventListener('click', () => {
      const i = Number(b.dataset.i);
      box.querySelectorAll('.opt').forEach((o) => o.classList.remove('right', 'wrong'));
      b.classList.add(i === answer ? 'right' : 'wrong');
      box.querySelector(`.opt[data-i="${answer}"]`)!.classList.add('right');
      const verdict = box.dataset.mode === 'predict'
        ? (i === answer ? '<strong>Yep.</strong> ' : '<strong>Not quite, but guessing first still helps it stick.</strong> ')
        : (i === answer ? '<strong>Right.</strong> ' : '<strong>Not quite.</strong> ');
      if (i !== answer && box.dataset.tag && box.dataset.mode !== 'predict') logError(box.dataset.tag);
      fb.innerHTML = verdict + (fb.dataset.base ??= fb.innerHTML);
      fb.hidden = false;
    }));
  });
</script>
