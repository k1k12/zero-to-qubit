---
// "Lock it in": a few flashcards embedded right after the idea they test.
// The same cards live in the Flashcards deck, so remembering them here also counts there.
import { CARDS } from '../data/cards';
import { tex } from '../lib/tex';
interface Props { ids: string[] }
const cards = Astro.props.ids.map((id) => CARDS.find((c) => c.id === id)).filter(Boolean);
---
<section class="lockin" aria-label="Lock it in: quick recall">
  <div class="eyebrow">Lock it in · answer in your head, then reveal</div>
  <div class="mini">
    {cards.map((c) => (
      <div class="mini-card" data-id={c!.id}>
        <div set:html={tex(c!.q)} />
        <div class="btn-row" style="margin:.5rem 0 0">
          <button class="btn small secondary reveal" type="button">Show answer</button>
        </div>
        <div class="answer">
          <div set:html={tex(c!.a)} />
          <div class="btn-row">
            <button class="btn small secondary grade" data-g="1" type="button">Forgot</button>
            <button class="btn small grade" data-g="3" type="button">Remembered</button>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
<script>
  import { review } from '../lib/srs';
  document.querySelectorAll<HTMLElement>('.lockin .mini-card').forEach((card) => {
    if (card.dataset.wired) return; card.dataset.wired = '1';
    card.querySelector('.reveal')!.addEventListener('click', (e) => { card.classList.add('open'); (e.currentTarget as HTMLElement).hidden = true; });
    card.querySelectorAll<HTMLButtonElement>('.grade').forEach((b) => b.addEventListener('click', () => {
      const when = review(card.dataset.id!, Number(b.dataset.g) as 1 | 3);
      card.querySelector('.answer .btn-row')!.innerHTML = `<span class="small muted">Saved. Next review: ${when}.</span>`;
    }));
  });
</script>
