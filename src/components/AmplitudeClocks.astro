---
// Amplitudes as arrows ("clocks"): length = size, angle = phase. Shows how a Hadamard
// adds and subtracts arrows, so interference becomes something you can see.
---
<div class="lab clocks">
  <div class="eyebrow">Amplitudes as arrows</div>
  <p class="notice">Each amplitude is an arrow: its <strong>length</strong> is the size (probability = length²) and its <strong>direction</strong> is the phase. Press H and look at the working panel: each new arrow is made by <strong>adding</strong> or <strong>subtracting</strong> the old ones, tip to tail. When arrows point opposite ways they cancel; that is interference.</p>
  <div class="lab-grid">
    <div>
      <div class="dials" style="display:grid;grid-template-columns:1fr 1fr;gap:.6rem"></div>
      <div class="eyebrow" style="margin-top:.6rem">Apply</div>
      <div class="btn-row">
        {['H', 'X', 'Z', 'S', 'T'].map((g) => <button class="btn small" type="button" data-g={g}>{g}</button>)}
        <button class="btn small secondary" type="button" data-reset>Reset to |0⟩</button>
      </div>
      <p class="small muted history"></p>
      <p class="small muted">Try: H, H (back to |0⟩: the |1⟩ arrows cancel). Then: H, Z, H (ends on |1⟩). Then H, S, H: neither cancels completely.</p>
    </div>
    <div>
      <div class="eyebrow">Working for the last gate</div>
      <div class="work"></div>
    </div>
  </div>
</div>
<script>
  import { c, add, mul, scale, abs2, expi, type C } from '../lib/sim';
  import { amp } from '../lib/ui';
  const S2 = Math.SQRT1_2;
  const arrow = (z: C, colour: string, R = 60, label = '') => {
    const x = z.re * R, y = -z.im * R, len = Math.hypot(x, y);
    const head = len > 6 ? `<polygon points="0,0 -9,-5 -9,5" fill="${colour}" transform="translate(${x},${y}) rotate(${(Math.atan2(y, x) * 180) / Math.PI})"/>` : '';
    return `<line x1="0" y1="0" x2="${x}" y2="${y}" stroke="${colour}" stroke-width="4" stroke-linecap="round"/>${head}${label}`;
  };
  const dial = (z: C, colour: string, name: string) => `
    <div style="text-align:center"><svg viewBox="-80 -80 160 160" width="100%" style="max-width:170px" role="img" aria-label="${name} amplitude ${amp(z)}, probability ${(abs2(z) * 100).toFixed(0)} percent">
      <circle r="60" fill="none" stroke="var(--line)" stroke-dasharray="3 3"/><line x1="-70" y1="0" x2="70" y2="0" stroke="var(--line)"/><line x1="0" y1="-70" x2="0" y2="70" stroke="var(--line)"/>
      ${arrow(z, colour)}</svg>
      <div><strong style="color:${colour}">${name}</strong>: ${amp(z)}<br><span class="small muted">P = ${(abs2(z) * 100).toFixed(1)}%</span></div></div>`;
  document.querySelectorAll<HTMLElement>('.clocks').forEach((root) => {
    const q = <T,>(s: string) => root.querySelector(s) as T;
    let a: C = c(1), b: C = c(0);
    let hist: string[] = [];
    function show(work = '') {
      q<HTMLElement>('.dials').innerHTML = dial(a, 'var(--alpha)', 'α (|0⟩)') + dial(b, 'var(--beta)', 'β (|1⟩)');
      q<HTMLElement>('.history').textContent = hist.length ? `Gates so far: ${hist.join(' → ')}` : 'Start: |0⟩ (α = 1, β = 0).';
      q<HTMLElement>('.work').innerHTML = work || '<p class="small muted">Press a gate.</p>';
    }
    const sumPic = (p: C, qv: C, sign: 1 | -1, colour: string, title: string) => {
      // draw p/√2 then ±q/√2 tip-to-tail, and the result
      const R = 60, p2 = scale(p, S2), q2 = scale(qv, sign * S2), r = add(p2, q2);
      const tip = `translate(${p2.re * R},${-p2.im * R})`;
      return `<div style="text-align:center"><svg viewBox="-90 -90 180 180" width="100%" style="max-width:200px">
        <circle r="60" fill="none" stroke="var(--line)" stroke-dasharray="3 3"/>
        <g opacity="0.55">${arrow(p2, 'var(--alpha)')}<g transform="${tip}">${arrow(q2, 'var(--beta)')}</g></g>
        ${arrow(r, colour)}</svg>
        <div class="small"><strong style="color:${colour}">${title}</strong> = (α ${sign > 0 ? '+' : '−'} β)/√2 = ${amp(r)}${abs2(r) < 1e-9 ? ' <strong>(cancelled!)</strong>' : ''}</div></div>`;
    };
    root.querySelectorAll<HTMLButtonElement>('[data-g]').forEach((btn) => btn.addEventListener('click', () => {
      const g = btn.dataset.g!;
      let work = '';
      if (g === 'H') {
        work = `<div style="display:grid;grid-template-columns:1fr 1fr;gap:.4rem">${sumPic(a, b, 1, 'var(--alpha)', 'new α')}${sumPic(a, b, -1, 'var(--beta)', 'new β')}</div><p class="small muted">Faint arrows: α/√2 (purple) then ±β/√2 (teal) placed tip to tail. Bold arrow: their sum, the new amplitude.</p>`;
        [a, b] = [scale(add(a, b), S2), scale(add(a, scale(b, -1)), S2)];
      } else if (g === 'X') { [a, b] = [b, a]; work = '<p>X swaps the two arrows. No adding, so no interference.</p>'; }
      else {
        const ang = g === 'Z' ? Math.PI : g === 'S' ? Math.PI / 2 : Math.PI / 4;
        b = mul(b, expi(ang));
        work = `<p>${g} turns only the β arrow by ${(ang * 180 / Math.PI).toFixed(0)}°. Probabilities don't change at all (lengths are the same), but the next H will add the arrows differently. That is why relative phase matters.</p>`;
      }
      hist.push(g); show(work);
    }));
    q<HTMLButtonElement>('[data-reset]').addEventListener('click', () => { a = c(1); b = c(0); hist = []; show(); });
    show();
  });
</script>
