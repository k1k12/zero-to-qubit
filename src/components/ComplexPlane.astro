---
// Lecture 2: drag a complex number around the plane and watch its parts change.
---
<div class="lab complex-lab">
  <div class="eyebrow">Try it: the complex plane</div>
  <p class="notice">Drag the purple dot (or focus it and use the arrow keys). <strong>Look out for:</strong> the conjugate is always the mirror image in the real axis, and |z| is just the length of the arrow.</p>
  <div class="lab-grid">
    <svg viewBox="-220 -220 440 440" role="application" aria-label="Complex plane. Use arrow keys to move z." style="touch-action:none;background:var(--bg);border-radius:12px;border:1px solid var(--line)">
      <g class="grid-lines" stroke="var(--line)" stroke-width="1"></g>
      <line x1="-210" y1="0" x2="210" y2="0" stroke="var(--muted)" />
      <line x1="0" y1="-210" x2="0" y2="210" stroke="var(--muted)" />
      <text x="196" y="-8" class="svg-muted" font-size="13">Re</text>
      <text x="8" y="-198" class="svg-muted" font-size="13">Im</text>
      <circle class="unit" r="100" fill="none" stroke="var(--line)" stroke-dasharray="4 4" />
      <path class="arc" fill="none" stroke="var(--shaky)" stroke-width="2" />
      <line class="vec-conj" stroke="var(--beta)" stroke-width="2" stroke-dasharray="6 5" />
      <circle class="dot-conj" r="7" fill="var(--beta)" />
      <line class="vec" stroke="var(--alpha)" stroke-width="3" />
      <line class="re-part" stroke="var(--muted)" stroke-dasharray="3 4" />
      <line class="im-part" stroke="var(--muted)" stroke-dasharray="3 4" />
      <circle class="dot" r="11" fill="var(--alpha)" tabindex="0" style="cursor:grab" />
      <text class="lbl-z svg-text" font-size="14">z</text>
      <text class="lbl-c" font-size="14" fill="var(--beta)">z̄</text>
    </svg>
    <div>
      <table>
        <tbody>
          <tr><th scope="row">z</th><td class="o-z"></td></tr>
          <tr><th scope="row">Re z, Im z</th><td class="o-parts"></td></tr>
          <tr><th scope="row">Conjugate z̄</th><td class="o-conj" style="color:var(--beta)"></td></tr>
          <tr><th scope="row">|z| = √(a² + b²)</th><td class="o-mod"></td></tr>
          <tr><th scope="row">arg z (phase θ)</th><td class="o-arg" style="color:var(--shaky)"></td></tr>
          <tr><th scope="row">Polar form</th><td class="o-polar"></td></tr>
          <tr><th scope="row">z · z̄ = |z|²</th><td class="o-zz"></td></tr>
        </tbody>
      </table>
      <div class="btn-row">
        <button class="btn small secondary" data-act="i" type="button">Multiply by i (rotate 90°)</button>
        <button class="btn small secondary" data-act="neg" type="button">Multiply by −1</button>
        <button class="btn small secondary" data-act="unit" type="button">Normalise (|z| = 1)</button>
      </div>
      <p class="small muted">Scale: the dashed circle has radius 1. Multiplying by e<sup>iθ</sup> only rotates; it never changes the length, which is why a phase never changes a probability.</p>
    </div>
  </div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('.complex-lab').forEach((root) => {
    const U = 100; // pixels per unit
    let a = 0.6, b = 0.8;
    const svg = root.querySelector('svg')!;
    const q = <T extends Element>(s: string) => root.querySelector(s) as unknown as T;
    const grid = q<SVGGElement>('.grid-lines');
    for (let k = -2; k <= 2; k++) if (k) grid.insertAdjacentHTML('beforeend', `<line x1="${k * U}" y1="-210" x2="${k * U}" y2="210"/><line x1="-210" y1="${k * U}" x2="210" y2="${k * U}"/><text x="${k * U + 3}" y="14" class="svg-muted" font-size="11">${k}</text><text x="4" y="${-k * U - 3}" class="svg-muted" font-size="11">${k}i</text>`);
    const f = (x: number) => (Math.abs(x) < 0.005 ? '0' : x.toFixed(2));
    const fz = (re: number, im: number) => `${f(re)} ${im < 0 ? '−' : '+'} ${f(Math.abs(im))}i`;
    function draw() {
      const x = a * U, y = -b * U;
      const set = (s: string, attrs: Record<string, number | string>) => { const el = q<SVGElement>(s); for (const k in attrs) el.setAttribute(k, String(attrs[k])); };
      set('.vec', { x1: 0, y1: 0, x2: x, y2: y });
      set('.vec-conj', { x1: 0, y1: 0, x2: x, y2: -y });
      set('.dot', { cx: x, cy: y }); set('.dot-conj', { cx: x, cy: -y });
      set('.re-part', { x1: x, y1: 0, x2: x, y2: y }); set('.im-part', { x1: 0, y1: y, x2: x, y2: y });
      set('.lbl-z', { x: x + 14, y: y - 10 }); set('.lbl-c', { x: x + 14, y: -y + 18 });
      const r = Math.hypot(a, b), th = Math.atan2(b, a);
      const R = 34, large = Math.abs(th) > Math.PI ? 1 : 0, sweep = th > 0 ? 0 : 1;
      q<SVGPathElement>('.arc').setAttribute('d', r > 0.05 ? `M ${R} 0 A ${R} ${R} 0 ${large} ${sweep} ${R * Math.cos(th)} ${-R * Math.sin(th)}` : '');
      q<HTMLElement>('.o-z').textContent = fz(a, b);
      q<HTMLElement>('.o-parts').textContent = `${f(a)}, ${f(b)}`;
      q<HTMLElement>('.o-conj').textContent = fz(a, -b);
      q<HTMLElement>('.o-mod').textContent = `√(${f(a)}² + ${f(b)}²) = ${r.toFixed(3)}`;
      q<HTMLElement>('.o-arg').textContent = `${(th * 180 / Math.PI).toFixed(1)}° = ${(th / Math.PI).toFixed(3)}π rad`;
      q<HTMLElement>('.o-polar').textContent = `${r.toFixed(3)} · e^(${th.toFixed(3)} i)`;
      q<HTMLElement>('.o-zz').textContent = `${(a * a + b * b).toFixed(3)} (always real)`;
    }
    const dot = q<SVGCircleElement>('.dot');
    let drag = false;
    const toLocal = (e: PointerEvent) => { const p = svg.createSVGPoint(); p.x = e.clientX; p.y = e.clientY; return p.matrixTransform(svg.getScreenCTM()!.inverse()); };
    dot.addEventListener('pointerdown', (e) => { drag = true; dot.setPointerCapture(e.pointerId); });
    dot.addEventListener('pointermove', (e) => { if (!drag) return; const p = toLocal(e); a = Math.max(-2, Math.min(2, p.x / U)); b = Math.max(-2, Math.min(2, -p.y / U)); draw(); });
    dot.addEventListener('pointerup', () => (drag = false));
    dot.addEventListener('keydown', (e) => {
      const k = (e as KeyboardEvent).key, s = 0.05;
      if (k === 'ArrowRight') a += s; else if (k === 'ArrowLeft') a -= s; else if (k === 'ArrowUp') b += s; else if (k === 'ArrowDown') b -= s; else return;
      e.preventDefault(); draw();
    });
    root.querySelectorAll<HTMLButtonElement>('[data-act]').forEach((btn) => btn.addEventListener('click', () => {
      if (btn.dataset.act === 'i') [a, b] = [-b, a];
      if (btn.dataset.act === 'neg') [a, b] = [-a, -b];
      if (btn.dataset.act === 'unit') { const r = Math.hypot(a, b) || 1; a /= r; b /= r; }
      draw();
    }));
    draw();
  });
</script>
