---
interface Props { type?: 'mistake' | 'notation' | 'idea' | 'deeper' | 'careful'; title?: string }
const { type = 'idea', title } = Astro.props;
const defaults = { mistake: '⚠ Common mistake', notation: '✎ Notation', idea: '◆ Key idea', deeper: '↧ Go deeper', careful: '! Careful' };
---
<aside class={`callout ${type}`} role="note">
  <div class="callout-title">{title ? `${defaults[type].split(' ')[0]} ${title}` : defaults[type]}</div>
  <slot />
</aside>
