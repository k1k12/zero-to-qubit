---
interface Props { type?: 'mistake' | 'notation' | 'idea' | 'deeper' | 'careful'; title?: string }
const { type = 'idea', title } = Astro.props;
const defaults = { mistake: 'Easy mistake to make', notation: 'Notation', idea: 'The main point', deeper: 'Extra', careful: 'Careful' };
const label = type === 'mistake' ? (title ? `Watch out: ${title.charAt(0).toLowerCase()}${title.slice(1)}` : defaults.mistake) : (title ?? defaults[type]);
---
<aside class={`callout ${type}`} role="note">
  <div class="callout-title">{label}</div>
  <slot />
</aside>
