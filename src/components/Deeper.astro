---
// Optional extra material past the syllabus. Levels: "Module+" (a bit beyond), "MSc", "PhD".
interface Props { title: string; level?: 'Module+' | 'MSc' | 'PhD' }
const { title, level = 'MSc' } = Astro.props;
const names = { 'Module+': 'a bit beyond the module', MSc: "master's level", PhD: 'PhD level' };
---
<details class="callout deeper">
  <summary>Extra: {title} <span class="level">{names[level]}</span></summary>
  <slot />
</details>
