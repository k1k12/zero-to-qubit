---
import Base from '../layouts/Base.astro';
const items = [
  ['/ideas', 'Big ideas', 'The physics and maths under each lecture, from spin to SU(2), with an interferometer to play with.'],
  ['/map', 'Concept map', 'How every idea depends on the others, and a study route to any topic.'],
  ['/notation', 'Notation decoder', 'Every symbol in plain words. Press / anywhere.'],
  ['/history', 'History', 'From Planck in 1900 to logical qubits, linked to the lectures.'],
  ['/library', 'Library', 'Books, papers, courses, videos and a podcast, by level.'],
  ['/tools', 'Tools', 'Simulators, optics labs, real hardware, maths help.'],
  ['/about', 'About', 'Why I made this and how it is set up.'],
];
---
<Base title="Explore">
  <h1>Extra stuff</h1>
  <p class="muted" style="max-width:720px">Reference pages and reading for when the lectures aren't enough (or you're procrastinating productively).</p>
  <div class="hub">{items.map(([h, t, d]) => <a class="card" href={h}><strong>{t}</strong><span class="small muted">{d}</span></a>)}</div>
</Base>
