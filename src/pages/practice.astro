---
import Base from '../layouts/Base.astro';
const items = [
  ['/flashcards', 'Flashcards', 'A few minutes a day. Cards come back just before you would forget them.'],
  ['/quiz', 'Mixed quiz', 'Exam-style questions from every lecture, mixed, with full working and an error log.'],
  ['/mock-exam', 'Mock exam', 'A full timed paper with a mark scheme. Do it by hand, then mark yourself.'],
  ['/code-lab', 'Code lab', 'Write Qiskit or OpenQASM, run it, and get feedback on common mistakes.'],
];
---
<Base title="Practice">
  <h1>Practice</h1>
  <p class="muted" style="max-width:720px">Rereading notes felt productive but didn't stick for me. Testing myself did. Flashcards for the facts, the quiz for picking the right method, and the mock exam for doing it all against the clock.</p>
  <div class="hub">{items.map(([h, t, d]) => <a class="card" href={h}><strong>{t}</strong><span class="small muted">{d}</span></a>)}</div>
</Base>
