---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { CARDS } from '../data/cards';
const lectures = (await getCollection('lectures')).sort((a, b) => a.data.number - b.data.number);
const lecInfo = lectures.map((l) => ({ slug: l.id, n: l.data.number, title: l.data.title }));
---
<Base title="Home">
  <section class="intro prose">
    <h1>Zero to Qubit</h1>
    <p>These are my notes for <strong>CSC3132 Introduction to Quantum Computing</strong> at Newcastle. I missed a couple of lectures and got properly lost around Bell's theorem, so I went back and wrote every lecture up from the start, assuming nothing, with diagrams I could actually play with.</p>
    <p>Every exercise from the slides is worked through, there are flashcards and practice questions, and each lecture has an "Extra" bit at the end for when you want to go past the syllabus. If you're doing the module too, I hope it helps.</p>
    <p class="btn-row" style="margin-top:1.2rem">
      <a class="btn" id="continue" href="/lectures/01-overview">Start with Lecture 1</a>
      <a class="btn secondary" href="/flashcards" id="review-btn">Flashcards</a>
    </p>
  </section>

  <div class="home-cols">
    <section>
      <h2>Lectures</h2>
      <ol class="lec-list">
        {lecInfo.map((l) => (
          <li data-slug={l.slug} class="lec">
            <a href={`/lectures/${l.slug}`}><span class="num">{l.n}.</span> {l.title}</a>
            <span class="pill mastery">not started</span>
          </li>
        ))}
        <li class="muted"><span class="num">10.</span> Hardware (coming once the slides are out)</li>
      </ol>
      <p class="small muted">The labels are how well you've marked each one. Change them at the top of a lecture.</p>
    </section>

    <aside>
      <h2>How I revise with it</h2>
      <ol class="routine" id="session"></ol>
      <div class="card small" style="margin-top:1.2rem">
        <strong>Module info</strong><br />
        Exam in January, closed book, worth 60%. The other 40% is the ten Canvas problem sets.
      </div>
      <h2>Also on here</h2>
      <ul class="also">
        <li><a href="/visuals">Visuals</a>: a 3D Bloch sphere, interference, entanglement, BB84</li>
        <li><a href="/mock-exam">Mock exam</a> (my draft, timed, with a mark scheme)</li>
        <li><a href="/quiz">Quiz</a> and the <a href="/code-lab">code lab</a> (Qiskit / OpenQASM)</li>
        <li><a href="/notation">Notation</a>, <a href="/map">concept map</a>, <a href="/ideas">big ideas</a>, <a href="/history">history</a>, <a href="/library">reading list</a></li>
      </ul>
    </aside>
  </div>
  <script type="application/json" id="home-data" set:html={JSON.stringify({ lectures: lecInfo, cardIds: CARDS.map((c) => c.id) })} />
</Base>
<style is:global>
  .intro { padding: .4rem 0 .6rem; }
  .intro p { font-size: 1.08rem; }
  .home-cols { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 3rem; }
  @media (max-width: 860px) { .home-cols { grid-template-columns: 1fr; gap: 0; } }
  .lec-list { list-style: none; padding: 0; margin: 1rem 0; }
  .lec-list li { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding: .55rem 0; border-bottom: 1px solid var(--rule); }
  .lec-list a { color: var(--text); text-decoration: none; font-family: var(--serif); font-size: 1.12rem; }
  .lec-list a:hover { color: var(--accent); text-decoration: underline; }
  .lec-list .num { color: var(--muted); display: inline-block; min-width: 1.8rem; }
  .routine { padding-left: 1.3rem; margin: 1rem 0; }
  .routine li { margin: .55rem 0; }
  .also { padding-left: 1.2rem; }
  .also li { margin: .35rem 0; }
</style>
<script>
  import { getMastery, load, save } from '../lib/store';
  import { dueIds } from '../lib/srs';
  const { lectures, cardIds } = JSON.parse(document.getElementById('home-data')!.textContent!) as { lectures: { slug: string; n: number; title: string }[]; cardIds: string[] };
  const m = getMastery();
  document.querySelectorAll<HTMLElement>('.lec[data-slug]').forEach((c) => {
    const v = m[c.dataset.slug!] ?? 'none'; const p = c.querySelector('.mastery')!;
    p.textContent = v === 'solid' ? 'got it' : v === 'shaky' ? 'shaky' : 'not started';
    p.className = `pill mastery ${v === 'solid' ? 'good' : v === 'shaky' ? 'shaky' : ''}`;
  });
  // what to learn next: the last lecture you opened if it isn't solid, otherwise the first one that isn't
  const last = load<string | null>('lastLecture', null);
  const next = (last && m[last] !== 'solid' ? lectures.find((l) => l.slug === last) : null) ?? lectures.find((l) => m[l.slug] !== 'solid') ?? lectures[lectures.length - 1];
  const cont = document.getElementById('continue') as HTMLAnchorElement;
  cont.href = `/lectures/${next.slug}`;
  cont.textContent = last ? `Carry on: Lecture ${next.n}` : 'Start with Lecture 1';
  const { due, fresh } = dueIds(cardIds);
  const nCards = due.length + Math.min(fresh.length, 10);
  (document.getElementById('review-btn') as HTMLAnchorElement).textContent = due.length ? `Flashcards (${due.length} due)` : 'Flashcards';
  const steps = [
    `<a href="/flashcards">Flashcards</a> first, about 5 minutes (${nCards} waiting). Remembering old stuff before new stuff really helps.`,
    `One section of <a href="/lectures/${next.slug}">Lecture ${next.n}: ${next.title}</a>. Try the "guess first" questions before reading the answer.`,
    `A <a href="/quiz">mixed quiz</a>. Mixing lectures is harder, but it's what the exam does.`,
    `<a href="#reflect">Explain it back</a> in a few sentences, then check against the one-page summary.`,
  ];
  document.getElementById('session')!.innerHTML = steps.map((s) => `<li>${s}</li>`).join('');
  document.querySelector('a[href="#reflect"]')!.addEventListener('click', (e) => {
    e.preventDefault();
    const box = document.getElementById('reflect-box');
    if (box) { box.remove(); return; }
    document.getElementById('session')!.insertAdjacentHTML('afterend', `<div class="card" id="reflect-box" style="margin-top:1rem"><label><strong>Explain Lecture ${next.n} to a friend who missed it, in 3 to 5 sentences.</strong><textarea id="reflect-text" placeholder="The main idea is..."></textarea></label><p class="small muted">Then open the one-page summary and see what you left out. This is saved in your browser.</p><a class="btn small secondary" href="/summaries/${next.slug}">Compare with the summary</a></div>`);
    const ta = document.getElementById('reflect-text') as HTMLTextAreaElement;
    ta.value = load(`reflect:${next.slug}`, '');
    ta.addEventListener('input', () => save(`reflect:${next.slug}`, ta.value));
    ta.focus();
  });
</script>
